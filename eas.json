{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium" },
      "autoIncrement": "version",
      "hooks": {
        "pre-install": "node ./scripts/write-env.js"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium" },
      "channel": "preview",
      "autoIncrement": "version",
      "hooks": {
        "pre-install": "node ./scripts/write-env.js"
      }
    },
    "production": {
      "distribution": "store",
      "ios": { "resourceClass": "m-medium" },
      "channel": "production",
      "autoIncrement": "version",
      "hooks": {
        "pre-install": "node ./scripts/write-env.js"
      }
    }
  },
  "submit": {
    "ios": {
      "ascAppId": null
    }
  }
}
